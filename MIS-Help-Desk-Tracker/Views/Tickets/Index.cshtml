@model IEnumerable<MisHelpDeskTracker.Models.Ticket>

@{
    ViewData["Title"] = "Help Desk Tickets";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-primary">Help Desk Tickets</h1>
            <p class="text-muted">Manage and track support requests for the district.</p>
        </div>
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-plus-circle"></i> Create New Ticket
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Title)</th>
                        <th>@Html.DisplayNameFor(model => model.Status)</th>
                        <th>@Html.DisplayNameFor(model => model.Priority)</th>
                        <th>@Html.DisplayNameFor(model => model.CreatedDate)</th>
                        <th>@Html.DisplayNameFor(model => model.AssignedTo)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@Html.DisplayFor(modelItem => item.Title)</td>
                            <td>
                                @if (item.Status == "Open")
                                {
                                    <span class="badge bg-danger">@item.Status</span>
                                }
                                else if (item.Status == "In Progress")
                                {
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@item.Status</span>
                                }
                            </td>
                            <td>
                                @if (item.Priority == "High")
                                {
                                    <span class="text-danger fw-bold">@item.Priority</span>
                                }
                                else
                                {
                                    @item.Priority
                                }
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                            <td>@Html.DisplayFor(modelItem => item.AssignedTo)</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.TicketId" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.TicketId" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.TicketId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>